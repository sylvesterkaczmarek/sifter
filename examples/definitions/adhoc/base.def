Bootstrap: docker
# Pinned by digest for a reproducible, supply-chain-safe base (still the ubuntu:24.04 tag).
From: ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

%labels
    Author Sifter Examples
    Description Simple base image for ad-hoc builds (no build args)

%post
    export DEBIAN_FRONTEND=noninteractive

    apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        && rm -rf /var/lib/apt/lists/*

    mkdir -p /opt/info
    echo "base" > /opt/info/layer

%runscript
    echo "Layer: $(cat /opt/info/layer)"
    exec "$@"
